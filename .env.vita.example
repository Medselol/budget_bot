# Add these only to source budget_bot; defaults remain disabled.
VITA_EXPORT_ENABLED=0
VITA_EXPORT_PORT=8787
VITA_PROJECT_IDS=
VITA_SOURCE_INSTANCE=
VITA_SOURCE_GENERATION=
# A dedicated read-only export secret, unrelated to any Telegram/API token.
VITA_SYNC_TOKEN=

# Independent VV → Vita project-only receiver, disabled by default.
# No native operation/account is created; never reuse VITA_SYNC_TOKEN here.
VITA_VV_WRITE_ENABLED=0
VITA_VV_WRITE_PORT=8788
VITA_VV_WRITE_TOKEN=
VITA_VV_SOURCE_INSTANCE=
VITA_VV_SOURCE_GENERATION=
# Exact JSON mapping from each VV payer to their own verified Vita project ID.
VITA_VV_PROJECT_MAPPING=
# Required explicit VV operation watermark; only later root operations qualify.
VITA_VV_AFTER_ID=

# Additive independent construction treasury; same existing write scope/token.
# Enable only after the v2 receiver/sender rollout and cutoff review.
VITA_VV_CONSTRUCTION_ENABLED=0
# Required explicitly when enabled; 0 only for the new empty treasury.
# VITA_VV_CONSTRUCTION_AFTER_ID=0
